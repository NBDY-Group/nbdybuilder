# nbdybuilder script config. Copy to .cursor/nbdybuilder/harness.env and edit. Plain KEY=value.
HARNESS_BASE=main
HARNESS_COMMIT_NAME="Cursor Agent"
HARNESS_COMMIT_EMAIL=cursoragent@cursor.com
# Append-only logs: conflicts keep both sides.
HARNESS_LOG_FILES="UPDATES.md CHANGELOG.md"
# Markdown ledgers with `| **ID** | ... | `state` |` rows: conflicts merge per row.
HARNESS_LEDGER_FILES=""
# Prose docs under this prefix: conflicts keep both sides (review the result).
HARNESS_PROSE_GLOB=docs/
# Generated files: taken from the branch, then regenerated.
HARNESS_GENERATED_GLOB=""
HARNESS_REGEN_CMD=""
HARNESS_VERIFY_CMD=""
# Semgrep: a custom rules file, and/or the public rulesets CI runs.
HARNESS_SEMGREP_RULES=""
HARNESS_SEMGREP_PATHS="."
HARNESS_SEMGREP_PUBLIC=0
# Extra regex alternatives for one-off infrastructure failures in this project's CI.
HARNESS_INFRA_PATTERN_EXTRA=""
